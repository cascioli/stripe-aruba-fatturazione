# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev/test). In production usa un percorso assoluto o un DSN PostgreSQL.
DATABASE_URL="file:./dev.db"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Chiave segreta Stripe. Usare "sk_test_*" in DEMO, "sk_live_*" in PROD.
STRIPE_SECRET_KEY=sk_test_replace_me

# Segreto per la verifica della firma degli webhook Stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Aruba Fatturazione Elettronica ───────────────────────────────────────────
# DEMO → ambiente sandbox Aruba (obbligatorio con sk_test_*)
# PROD → ambiente di produzione (richiede sk_live_* Stripe)
ARUBA_ENV=DEMO

# DRAFT → le fatture vengono create come bozza (consigliato finché non sei in prod)
# DIRECT → invio immediato allo SDI
ARUBA_SEND_MODE=DRAFT

# Credenziali account Aruba Fatturazione Elettronica
ARUBA_USERNAME=replace_me@example.com
ARUBA_PASSWORD=replace_me_password

# ─── Notifiche (opzionale) ────────────────────────────────────────────────────
# URL webhook per alert interni (es. Slack incoming webhook).
# Lascia vuoto per disabilitare.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
