// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FatturaJob {
  id                  String    @id @default(cuid())
  stripeEventId       String    @unique
  stripeInvoiceId     String?
  stripeRefundId      String?
  // Unique fiscal document key — prevents double Aruba invoices for the same Stripe document.
  // Format: "<invoiceId>:TD01" | "<invoiceId>:TD04:voided" | "<invoiceId>:TD04:<refundId>"
  fiscalDocumentKey   String?   @unique
  eventType           String    // invoice.paid | charge.refunded | invoice.voided

  status              String    @default("PENDING")
  // PENDING | CREATED_DRAFT | SENT_SDI | FAILED_VALIDATION | ERROR

  arubaInvoiceId      String?
  arubaUploadFileName String?

  // Tracks metadata write-back to Stripe independently of Aruba status.
  // Covers both success states (arubaInvoiceId present) and failure states (status-only write-back).
  // null = not yet needed | PENDING = write-back needed (not yet attempted) | OK = synced | FAILED = needs retry
  metadataSyncStatus  String?

  // Optimistic lock fields for atomic job claiming — prevents concurrent Aruba calls.
  lockedAt            DateTime?
  lockedBy            String?

  retryCount          Int       @default(0)
  nextRetryAt         DateTime?
  lastError           String?
  alerted             Boolean   @default(false)

  rawPayload          String    // JSON evento Stripe (testo)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([stripeEventId])
  @@index([fiscalDocumentKey])
}
